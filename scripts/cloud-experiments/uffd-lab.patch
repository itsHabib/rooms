+// Disposable lab variant: no production switch or public API.
+pub struct LabUffd(std::process::Child);
+impl LabUffd {
+    async fn start(jail: &Path, uid: u32, gid: u32) -> anyhow::Result<Self> {
+        std::fs::copy(
+            "/usr/local/libexec/rooms-lab-uffd",
+            jail.join("uffd-handler"),
+        )?;
+        let child = std::process::Command::new("/usr/sbin/chroot")
+            .arg(format!("--userspec={uid}:{gid}"))
+            .arg(format!("--groups={gid}"))
+            .arg(jail)
+            .args(["/uffd-handler", "/uffd.sock", "/snapshot.mem"])
+            .env_clear()
+            .spawn()?;
+        let mut guard = Self(child);
+        for _ in 0..200 {
+            if let Some(status) = guard.0.try_wait()? {
+                anyhow::bail!("lab UFFD handler exited before readiness: {status}");
+            }
+            if jail.join("uffd.sock").exists() {
+                return Ok(guard);
+            }
+            tokio::time::sleep(std::time::Duration::from_millis(10)).await;
+        }
+        anyhow::bail!("lab UFFD socket readiness timed out")
+    }
+}
+impl Drop for LabUffd {
+    fn drop(&mut self) {
+        let _ = self.0.kill();
+        let _ = self.0.wait();
+    }
+}
